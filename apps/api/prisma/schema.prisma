generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ENGINEER
  CONTRACTOR
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(ENGINEER)

  projects Project[]

  authoredIssues Issue[] @relation("IssueAuthor")
  assignedIssues Issue[] @relation("IssueAssignee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  buildings Building[] 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model Building {
  id   String @id @default(uuid())
  name String

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  floors Floor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
}

model Floor {
  id    String  @id @default(uuid())
  level Int
  name  String?

  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issues Issue[]

  @@unique([buildingId, level])
  @@index([buildingId])
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Issue {
  id          String        @id @default(uuid())
  title       String
  description String?
  status      IssueStatus   @default(OPEN)
  priority    IssuePriority @default(MEDIUM)

  floorId String
  floor   Floor @relation(fields: [floorId], references: [id], onDelete: Cascade)

  authorId String
  author   User @relation("IssueAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  assigneeId String?
  assignee   User? @relation("IssueAssignee",fields: [assigneeId],references: [id],onDelete: SetNull)

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([floorId, status])
  @@index([priority])
  @@index([authorId])
  @@index([assigneeId])
}