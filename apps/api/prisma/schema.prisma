generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ENGINEER
  CONTRACTOR
}
enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectRole {
  OWNER
  ENGINEER
  CONTRACTOR
}
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(ENGINEER)
  uploadedAttachments Attachment[]
  projects Project[]
  projectMemberships ProjectMember[]
  issueComments IssueComment[]
  authoredIssues Issue[] @relation("IssueAuthor")
  assignedIssues Issue[] @relation("IssueAssignee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])
  members ProjectMember[]
  buildings Building[] 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model ProjectMember {
  id   String      @id @default(uuid())
  role ProjectRole

  projectId String
  project   Project @relation(fields: [projectId],references: [id],onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId],references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
}

model Building {
  id   String @id @default(uuid())
  name String

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  floors Floor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
}

model Floor {
  id    String  @id @default(uuid())
  level Int
  name  String?

  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issues Issue[]

  @@unique([buildingId, level])
  @@index([buildingId])
}


model Issue {
  id          String        @id @default(uuid())
  title       String
  description String?
  status      IssueStatus   @default(OPEN)
  priority    IssuePriority @default(MEDIUM)
  comments IssueComment[]
  floorId String
  floor   Floor @relation(fields: [floorId], references: [id], onDelete: Cascade)

  authorId String
  author   User @relation("IssueAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  assigneeId String?
  assignee   User? @relation("IssueAssignee",fields: [assigneeId],references: [id],onDelete: SetNull)
  attachments Attachment[]
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([floorId, status])
  @@index([priority])
  @@index([authorId])
  @@index([assigneeId])
}
model IssueComment {
  id      String @id @default(uuid())
  content String

  issueId String
  issue   Issue @relation(fields: [issueId],references: [id],onDelete: Cascade)

  authorId String
  author   User @relation(fields: [authorId],references: [id],onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId, createdAt])
  @@index([authorId])
}
model Attachment {
  id           String @id @default(uuid())
  originalName String
  storedName   String @unique
  mimeType     String
  size         Int

  issueId String
  issue   Issue @relation(fields: [issueId],references: [id],onDelete: Cascade)

  uploaderId String
  uploader   User @relation(fields: [uploaderId],references: [id],onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
  @@index([uploaderId])
}